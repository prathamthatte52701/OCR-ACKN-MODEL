MONGO_URI=
# Optional. Blank or missing = ackn_AI_model
# MONGO_DB_NAME=ackn_AI_model
GROQ_API_KEYS=
# Model used for field extraction; blank = openai/gpt-oss-120b
GROQ_MODEL=
# low / medium / high. If the line is missing, "high" is used. A BLANK value (GROQ_REASONING_EFFORT=)
# means the parameter is not sent at all - needed for models without a reasoning mode.
GROQ_REASONING_EFFORT=high
# Answer length limit, whole number 50-4000. Blank or missing = 2000. If an answer is cut off, it is
# retried once with double this limit (at most 4000).
GROQ_MAX_TOKENS=
JWT_SECRET=
# Audit-log entries older than this many days are deleted automatically (MongoDB TTL index).
# Whole number 0-3650; 0 = keep forever; blank or missing = 365.
# AUDIT_LOG_RETENTION_DAYS=365
# Optional. Blank or missing = http://localhost:5174
# FRONTEND_ORIGIN=http://localhost:5174
# Optional. Blank or missing = http://localhost:5175
# ADMIN_ORIGIN=http://localhost:5175
ADMIN_1_PASSWORD=
ADMIN_2_PASSWORD=
ADMIN_1_NAME=
ADMIN_1_EMAIL=
ADMIN_2_NAME=
ADMIN_2_EMAIL=
# Set to true only on a developer machine to expose /docs, /redoc, /openapi.json
ENABLE_DOCS=
# Optional: Google Sign-In (frontend needs the matching VITE_GOOGLE_CLIENT_ID)
GOOGLE_CLIENT_ID=
