MONGO_URI=
MONGO_DB_NAME=
GROQ_API_KEYS=
# Model used for field extraction; blank = openai/gpt-oss-120b
GROQ_MODEL=
# Leave the line out for the default (low). low / medium / high. Set it BLANK (as below) to not send
# the parameter at all - needed for models without a reasoning mode.
GROQ_REASONING_EFFORT=low
# Answer length limit, whole number 50-4000. Blank = 300.
GROQ_MAX_TOKENS=
JWT_SECRET=
FRONTEND_ORIGIN=
ADMIN_ORIGIN=
ADMIN_1_PASSWORD=
ADMIN_2_PASSWORD=
ADMIN_1_NAME=
ADMIN_1_EMAIL=
ADMIN_2_NAME=
ADMIN_2_EMAIL=
# Set to true only on a developer machine to expose /docs, /redoc, /openapi.json
ENABLE_DOCS=
